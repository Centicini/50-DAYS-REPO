   "source": [
    "\n",
    "\n",
    "def average_age(path):\n",
    "    f = open(path)\n",
    "    total = 0\n",
    "    count = 0\n",
    "    \n",
    "    try:\n",
    "        for line in f.readlines()[1:]:\n",
    "            total += int(line.split(\",\")[1])\n",
    "            count += 1\n",
    "        \n",
    "    except:\n",
    "        pass\n",
    "    \n",
    "    return total / count\n"
   ]
